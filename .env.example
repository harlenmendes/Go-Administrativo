# =============================================================================
# 1. FRONTEND (Vite + Supabase Auth + Prontuário)
# =============================================================================
VITE_SUPABASE_URL=https://seu-projeto-id.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# =============================================================================
# 2. BACKEND SERVERLESS VERCEL (Google Calendar/Sheets + Schema go_fechamento)
# =============================================================================
SUPABASE_URL=https://seu-projeto-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui
SUPABASE_SCHEMA=go_fechamento

# Credenciais Google OAuth2 (usadas para importar atendimentos do Calendar e exportar Sheets)
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui

# Chave secreta para criptografar o cookie de sessão Google (texto longo aleatório)
SESSION_SECRET=troque_por_uma_frase_secreta_longa_e_aleatoria_123456

# (Opcional) URL base forçada em produção (ex: https://go-administrativo.vercel.app)
APP_BASE_URL=

